{
  "//": "Разрешения на то, что в этом проекте делается постоянно: чтобы новый чат не тратил ходы на спрашивание.",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(node tools/:*)",
      "Bash(node --experimental-strip-types tools/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ветки.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "//ветки": "Крючок начала чата печатает, что лежит в ветках и не дошло до main (tools/ветки.mjs). Крючок конца хода, который двигает main, включается словом Алекса."
}
